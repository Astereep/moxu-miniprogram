/* 材料库样式 */
.material-page {
  padding-bottom: 70rpx;
}

.lib-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 6rpx 0 24rpx;
}

.lib-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #2C3036;
}

.lib-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A8F96;
}

.lib-count {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.chip-scroll {
  width: 100%;
  height: 68rpx;
  margin-top: 22rpx;
  white-space: nowrap;
}

/* 材料卡片 */
.mat-card {
  margin-top: 18rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.mat-card-open {
  border-color: #E9C3AF;
}

.mat-head {
  display: flex;
  align-items: center;
}

.mat-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 52rpx;
  padding: 0 10rpx;
  background: #2C3036;
  border-radius: 6rpx;
  color: #FFFFFF;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.mat-title {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.mat-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #2C3036;
}

.mat-en {
  display: block;
  margin-top: 3rpx;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #A6ABB1;
}

.mat-cat {
  margin-right: 8rpx;
  padding: 2rpx 10rpx;
  background: #F2EFEA;
  border-radius: 4rpx;
  font-size: 19rpx;
  color: #8A8F96;
}

.mat-toggle {
  font-size: 21rpx;
  color: #E27B48;
}

/* 速览 */
.mat-quick {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1EEEA;
}

.quick-cell {
  flex: 1;
  min-width: 0;
}

.quick-cell-right {
  padding-left: 20rpx;
  border-left: 2rpx solid #F1EEEA;
}

.quick-label {
  display: block;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.quick-value {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #4A505A;
}

/* 展开详情 */
.mat-detail {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1EEEA;
}

.detail-row {
  margin-bottom: 18rpx;
}

.detail-label {
  display: block;
  margin-bottom: 5rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.detail-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.68;
  color: #4A505A;
}

.safety-box {
  margin: 6rpx 0 18rpx;
  padding: 16rpx 18rpx;
  background: #FFF6F2;
  border-left: 6rpx solid #E27B48;
}

.safety-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #C96637;
}

.pros-cons {
  display: flex;
  padding-top: 4rpx;
}

.pc-col {
  flex: 1;
  min-width: 0;
}

.pc-col + .pc-col {
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid #F1EEEA;
}

.pc-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #2C3036;
}

.pc-title-con {
  color: #B9503A;
}

.mat-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.mat-tags .tag {
  margin: 0 10rpx 8rpx 0;
}
