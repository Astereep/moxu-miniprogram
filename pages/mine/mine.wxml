<!-- 我的：本地数据说明与关于 -->
<view class="page mine-page">

  <!-- 品牌头 -->
  <view class="mine-hero">
    <view class="mine-mark">M</view>
    <view class="mine-info">
      <text class="mine-name">模序</text>
      <text class="mine-version">VERSION {{version}} · LOCAL FIRST</text>
    </view>
    <text class="mine-tag">工具</text>
  </view>

  <!-- 统计 -->
  <view class="stat-card card">
    <view class="stat-cell">
      <text class="stat-num num">{{projectCount}}</text>
      <text class="stat-label">项目</text>
    </view>
    <view class="stat-cell">
      <text class="stat-num num">{{stepCount}}</text>
      <text class="stat-label">工序</text>
    </view>
    <view class="stat-cell">
      <text class="stat-num num">{{doneCount}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-cell">
      <text class="stat-num num">{{donePercent}}%</text>
      <text class="stat-label">完成率</text>
    </view>
  </view>
  <view class="storage-line">
    <text>本地 Storage 占用 {{storageSize}}</text>
    <text class="num">KEY: mx_projects</text>
  </view>

  <!-- 本地数据说明 -->
  <view class="section-title">本地数据说明</view>
  <view class="card info-card">
    <view class="info-row" wx:for="{{localNotes}}" wx:key="*this">
      <view class="info-dot"></view>
      <text class="info-text">{{item}}</text>
    </view>
  </view>

  <!-- 内置内容 -->
  <view class="section-title">内置资料</view>
  <view class="builtin-card card">
    <view class="builtin-cell">
      <text class="builtin-num num">{{builtin.templates}}</text>
      <text class="builtin-label">套工序模板</text>
    </view>
    <view class="builtin-cell">
      <text class="builtin-num num">{{builtin.materials}}</text>
      <text class="builtin-label">种常用材料</text>
    </view>
    <view class="builtin-cell">
      <text class="builtin-num num">{{builtin.defects}}</text>
      <text class="builtin-label">类缺陷修复</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section-title">关于模序</view>
  <view class="card about-card">
    <text class="about-title">面向工业设计与手板制作的工序管理工具</text>
    <text class="about-text">模序把「模型制作」拆成可勾选、可计时、可复盘的工序序列，内置油泥与光敏树脂两套标准模板，以及常用材料参数与缺陷修复方案。</text>
    <text class="about-text">适用：工业设计学生、手板制作者、模型工坊。无需登录，打开即用，全部数据留在本机。</text>
    <view class="about-meta">
      <text>版本 {{version}}</text>
      <text>无后端 · 无网络请求</text>
    </view>
  </view>

  <!-- 清空数据 -->
  <view class="danger-card">
    <view class="danger-main">
      <text class="danger-title">清空全部本地数据</text>
      <text class="danger-desc">删除项目、工序与本地照片，不可恢复</text>
    </view>
    <view class="btn btn-danger btn-sm danger-btn" bindtap="clearAll">清空</view>
  </view>

  <text class="page-tip">MODEL SEQUENCE · 模序 v{{version}}</text>
</view>
