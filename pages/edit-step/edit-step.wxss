/* 工序编辑样式 */
.edit-page {
  padding-bottom: 190rpx;
}

.crumb {
  display: flex;
  align-items: center;
  padding: 4rpx 0 22rpx;
}

.crumb-label {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.crumb-name {
  flex: 1;
  margin: 0 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 23rpx;
  color: #4A505A;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-count {
  font-size: 21rpx;
  color: #A6ABB1;
}

.desc-area {
  height: 210rpx;
}

.note-area {
  height: 140rpx;
}

.minute-row {
  display: flex;
  align-items: center;
}

.minute-input {
  width: 220rpx;
  margin-right: 16rpx;
}

.minute-unit {
  font-size: 25rpx;
  color: #8A8F96;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #A6ABB1;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
}

.photo-item,
.photo-add {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 190rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-item {
  margin-right: 12rpx;
}

.photo-item:nth-child(3n) {
  margin-right: 0;
}

.photo-img {
  display: block;
  width: 100%;
  height: 100%;
  background: #EFECE7;
}

.photo-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(28, 31, 35, 0.6);
  border-bottom-left-radius: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D2CDC4;
  background: #FAF9F7;
}

.photo-add-hover {
  background: #F2EFEA;
}

.photo-plus {
  font-size: 38rpx;
  line-height: 1;
  color: #C0BCB4;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A6ABB1;
}

/* 删除工序 */
.delete-link {
  margin-top: 30rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #B9503A;
}

.cancel-btn {
  flex: 0 0 180rpx;
}
