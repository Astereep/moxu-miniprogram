<!-- 工序编辑：名称、说明、建议时长、现场照片、备注 -->
<view class="page edit-page">

  <view class="crumb">
    <text class="crumb-label">所属项目</text>
    <text class="crumb-name">{{projectName}}</text>
    <text class="tag {{isEdit ? 'tag-accent' : ''}}">{{isEdit ? '编辑工序' : '新增工序'}}</text>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="label">工序名称<text class="req">*</text><text class="label-en">STEP</text></text>
      <input
        class="input"
        maxlength="20"
        placeholder="例如：400 目粗磨"
        placeholder-class="placeholder"
        value="{{name}}"
        bindinput="onName"
      />
    </view>

    <view class="field">
      <text class="label">操作说明<text class="label-en">PROCESS</text></text>
      <textarea
        class="textarea desc-area"
        maxlength="300"
        placeholder="记录操作手法、注意事项、验收标准"
        placeholder-class="placeholder"
        value="{{desc}}"
        bindinput="onDesc"
      />
    </view>

    <view class="field">
      <text class="label">建议时长<text class="label-en">DURATION</text></text>
      <view class="minute-row">
        <input
          class="input minute-input"
          type="number"
          maxlength="3"
          placeholder="30"
          placeholder-class="placeholder"
          value="{{minutes}}"
          bindinput="onMinutes"
        />
        <text class="minute-unit">分钟</text>
      </view>
      <text class="field-hint">计时页会默认使用该时长</text>
    </view>

    <view class="field">
      <view class="label-row">
        <text class="label">现场照片<text class="label-en">PHOTOS</text></text>
        <text class="label-count">{{photos.length}} / 6</text>
      </view>
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="*this" class="photo-item">
          <image class="photo-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" />
          <view class="photo-del" data-index="{{index}}" catchtap="removePhoto">×</view>
        </view>
        <view wx:if="{{photos.length < 6}}" class="photo-add" bindtap="choosePhotos" hover-class="photo-add-hover">
          <text class="photo-plus">＋</text>
          <text class="photo-add-text">添加</text>
        </view>
      </view>
      <text class="field-hint">照片仅保存在本机，不上传服务器</text>
    </view>

    <view class="field">
      <text class="label">工序备注<text class="label-en">NOTE</text></text>
      <textarea
        class="textarea note-area"
        maxlength="200"
        placeholder="记录异常、材料批次或返工点"
        placeholder-class="placeholder"
        value="{{note}}"
        bindinput="onNote"
      />
      <text class="counter">{{note.length}} / 200</text>
    </view>
  </view>

  <view wx:if="{{isEdit}}" class="delete-link" bindtap="removeStep">删除此工序</view>

  <view class="bottom-bar">
    <view class="btn btn-ghost bottom-btn cancel-btn" bindtap="goBack">取消</view>
    <view class="btn btn-primary bottom-btn" bindtap="save">{{saving ? '保存中…' : '保存工序'}}</view>
  </view>
</view>
