/* app.wxss —— 全局样式：理性工装工具风
 * 主色 #2C3036 / 强调色 #E27B48 / 纸面 #F4F2EF
 * 小圆角、细描边、低动效，全部尺寸使用 rpx
 */
page {
  --ink: #2C3036;
  --ink-light: #4A505A;
  --muted: #8A8F96;
  --line: #E3DFD9;
  --line-strong: #D2CDC4;
  --paper: #F4F2EF;
  --card: #FFFFFF;
  --accent: #E27B48;
  --accent-soft: #FAEDE5;
  --danger: #B9503A;

  background-color: #F4F2EF;
  color: #2C3036;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
image,
button,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 80rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

/* ---------- 区块标题 ---------- */
.section-title {
  display: flex;
  align-items: center;
  margin: 36rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #2C3036;
}

.section-title::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  margin-right: 14rpx;
  background: #E27B48;
  border-radius: 2rpx;
  flex-shrink: 0;
}

.section-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: #8A8F96;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  margin: 0;
  border: none;
  border-radius: 8rpx;
  background: transparent;
  color: #2C3036;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #E27B48;
  color: #FFFFFF;
}

.btn-primary-hover {
  background: #C96637;
}

.btn-dark {
  background: #2C3036;
  color: #FFFFFF;
}

.btn-dark-hover {
  background: #1D2126;
}

.btn-ghost {
  background: #FFFFFF;
  border: 2rpx solid #D2CDC4;
  color: #2C3036;
}

.btn-ghost-hover {
  background: #EFECE7;
}

.btn-sm {
  height: 68rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.btn-danger {
  background: #FFFFFF;
  border: 2rpx solid #E5C4BA;
  color: #B9503A;
}

.btn-disabled {
  opacity: 0.45;
}

/* ---------- 表单 ---------- */
.form-card {
  padding: 4rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.field {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F1EEEA;
}

.field:last-child {
  border-bottom: none;
}

.label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #4A505A;
}

.label-en {
  margin-left: 10rpx;
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #A6ABB1;
}

.req {
  margin-left: 6rpx;
  color: #E27B48;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  background: #FAF9F7;
  border: 2rpx solid #E3DFD9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #2C3036;
}

.textarea {
  width: 100%;
  height: 176rpx;
  padding: 18rpx 22rpx;
  background: #FAF9F7;
  border: 2rpx solid #E3DFD9;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2C3036;
}

.placeholder {
  color: #B6B9BE;
}

.counter {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #A6ABB1;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  background: #F0EDE8;
  border-radius: 4rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #4A505A;
}

.tag-accent {
  background: #FAEDE5;
  color: #E27B48;
}

.tag-dark {
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
}

/* ---------- 搜索框 ---------- */
.search-box {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx 0 76rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 8rpx;
}

.search-icon {
  position: absolute;
  left: 27rpx;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin-top: -15rpx;
  border: 3rpx solid #A6ABB1;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 3rpx;
  background: #A6ABB1;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 27rpx;
  color: #2C3036;
}

.search-clear {
  padding-left: 16rpx;
  font-size: 22rpx;
  color: #8A8F96;
}

/* ---------- 筛选标签 ---------- */
.chip-row {
  display: flex;
  flex-wrap: nowrap;
  padding: 4rpx 0;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #8A8F96;
  flex-shrink: 0;
}

.chip-active {
  background: #FAEDE5;
  border-color: #E27B48;
  color: #E27B48;
  font-weight: 500;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 76rpx 32rpx;
  text-align: center;
}

.empty-mark {
  display: block;
  font-size: 52rpx;
  letter-spacing: 8rpx;
  color: #D2CDC4;
}

.empty-title {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3036;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8F96;
}

/* ---------- 底部固定操作条 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  padding: 18rpx 32rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 2rpx solid #E3DFD9;
}

.bottom-btn {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

.bottom-btn + .bottom-btn {
  margin-left: 20rpx;
}

/* ---------- 杂项 ---------- */
.num {
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
}

.page-tip {
  display: block;
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A8F96;
}

.hairline {
  height: 2rpx;
  background: #F1EEEA;
}

/* 去掉 scroll-view 横向滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
