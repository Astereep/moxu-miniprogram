/* 新建项目样式 */
.create-page {
  padding-bottom: 100rpx;
}

/* 类型选择 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
}

.type-item {
  width: calc(50% - 8rpx);
  padding: 18rpx 20rpx;
  background: #FAF9F7;
  border: 2rpx solid #E3DFD9;
  border-radius: 8rpx;
}

.type-item:nth-child(2n) {
  margin-left: 16rpx;
}

.type-item:nth-child(n + 3) {
  margin-top: 16rpx;
}

.type-item-active {
  background: #FAEDE5;
  border-color: #E27B48;
}

.type-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #2C3036;
}

.type-dot {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #C7C3BB;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.type-item-active .type-dot {
  background: #E27B48;
  border-color: #E27B48;
}

.type-en {
  display: block;
  margin-top: 4rpx;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #A6ABB1;
}

/* 封面 */
.cover-box {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #FAF9F7;
  border: 2rpx dashed #D2CDC4;
}

.cover-img {
  display: block;
  width: 100%;
  height: 100%;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.cover-plus {
  font-size: 46rpx;
  line-height: 1;
  color: #C0BCB4;
}

.cover-tip {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #4A505A;
}

.cover-hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A6ABB1;
}

.cover-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.cover-link {
  padding: 4rpx 0 4rpx 24rpx;
  font-size: 22rpx;
  color: #8A8F96;
}

.cover-danger {
  color: #B9503A;
}

/* 模板列表 */
.tpl-list {
  display: flex;
  flex-direction: column;
}

.tpl-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.tpl-item-active {
  border-color: #E27B48;
  background: #FFF9F5;
}

.tpl-head {
  display: flex;
  align-items: center;
}

.tpl-radio {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  border: 2rpx solid #C7C3BB;
  border-radius: 50%;
  background: #FFFFFF;
  flex-shrink: 0;
}

.tpl-radio-on {
  border-color: #E27B48;
}

.tpl-radio-on::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  margin-top: -7rpx;
  background: #E27B48;
  border-radius: 50%;
}

.tpl-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3036;
}

.tpl-desc {
  display: block;
  margin-top: 8rpx;
  padding-left: 44rpx;
  font-size: 22rpx;
  color: #8A8F96;
}

.tpl-steps {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
  padding-left: 44rpx;
}

.tpl-step {
  margin: 0 12rpx 8rpx 0;
  padding: 3rpx 10rpx;
  background: #F2EFEA;
  border-radius: 4rpx;
  font-size: 19rpx;
  color: #4A505A;
}

/* 提交 */
.submit-btn {
  width: 100%;
  margin-top: 40rpx;
}
