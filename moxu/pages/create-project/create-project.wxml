<!-- 新建项目：基础信息 + 封面 + 工序模板一键导入 -->
<view class="page create-page">

  <view class="form-card">
    <view class="field">
      <text class="label">项目名称<text class="req">*</text><text class="label-en">NAME</text></text>
      <input
        class="input"
        maxlength="24"
        placeholder="例如：油泥手板灯罩 / 外壳后处理"
        placeholder-class="placeholder"
        value="{{name}}"
        bindinput="onName"
      />
    </view>

    <view class="field">
      <text class="label">模型类型<text class="label-en">TYPE</text></text>
      <view class="type-grid">
        <view
          wx:for="{{types}}"
          wx:key="key"
          class="type-item {{typeIndex === index ? 'type-item-active' : ''}}"
          data-index="{{index}}"
          bindtap="onType"
        >
          <view class="type-top">
            <text class="type-name">{{item.name}}</text>
            <view class="type-dot"></view>
          </view>
          <text class="type-en">{{item.en}}</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="label">项目备注<text class="label-en">NOTE</text></text>
      <textarea
        class="textarea"
        maxlength="200"
        placeholder="比例、交付节点、甲方要求等"
        placeholder-class="placeholder"
        value="{{remark}}"
        bindinput="onRemark"
      />
      <text class="counter">{{remark.length}} / 200</text>
    </view>

    <view class="field">
      <text class="label">封面图片<text class="label-en">COVER</text></text>
      <view class="cover-box" bindtap="chooseCover">
        <image wx:if="{{cover}}" class="cover-img" src="{{cover}}" mode="aspectFill" />
        <view wx:else class="cover-empty">
          <text class="cover-plus">＋</text>
          <text class="cover-tip">上传封面图</text>
          <text class="cover-hint">仅保存在本机</text>
        </view>
      </view>
      <view wx:if="{{cover}}" class="cover-actions">
        <text class="cover-link" catchtap="chooseCover">更换封面</text>
        <text class="cover-link cover-danger" catchtap="removeCover">移除</text>
      </view>
    </view>
  </view>

  <view class="section-title">工序模板<text class="section-sub">可一键导入，之后仍可增删</text></view>

  <view class="tpl-list">
    <view
      wx:for="{{templates}}"
      wx:key="key"
      class="tpl-item {{tplIndex === index ? 'tpl-item-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTpl"
    >
      <view class="tpl-head">
        <view class="tpl-radio {{tplIndex === index ? 'tpl-radio-on' : ''}}"></view>
        <text class="tpl-name">{{item.name}}</text>
      </view>
      <text class="tpl-desc">{{item.desc}}</text>
      <view wx:if="{{item.steps.length}}" class="tpl-steps">
        <text
          wx:for="{{item.steps}}"
          wx:for-item="stepItem"
          wx:for-index="stepIndex"
          wx:key="name"
          class="tpl-step"
        >{{stepIndex + 1}} · {{stepItem.name}}</text>
      </view>
    </view>
  </view>

  <button class="btn btn-primary submit-btn" hover-class="btn-primary-hover" bindtap="submit">
    {{saving ? '创建中…' : '创建项目'}}
  </button>
  <text class="page-tip">全部数据保存在本机 Storage，不上传服务器</text>
</view>
