<!-- 缺陷修复手册：搜索 + 标签筛选 + 缺陷列表 -->
<view class="page repair-page">

  <view class="lib-head">
    <view>
      <text class="lib-title">DEFECT MANUAL</text>
      <text class="lib-sub">{{total}} 类常见缺陷 · 成因 / 修复 / 耗材 / 避坑</text>
    </view>
    <text class="lib-count num">{{list.length}} / {{total}}</text>
  </view>

  <view class="search-box">
    <view class="search-icon"></view>
    <input
      class="search-input"
      placeholder="搜索缺陷 / 材料 / 修复方法"
      placeholder-class="placeholder"
      value="{{keyword}}"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear" catchtap="clearKeyword">清除</text>
  </view>

  <scroll-view class="chip-scroll" scroll-x enable-flex>
    <view class="chip-row">
      <view
        wx:for="{{tags}}"
        wx:key="*this"
        class="chip {{activeTag === item ? 'chip-active' : ''}}"
        data-tag="{{item}}"
        bindtap="onTag"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 缺陷列表 -->
  <view
    wx:for="{{list}}"
    wx:key="id"
    class="defect-card"
    data-id="{{item.id}}"
    bindtap="openDetail"
    hover-class="defect-hover"
  >
    <text class="defect-no num">{{item.no}}</text>
    <view class="defect-body">
      <view class="defect-head">
        <text class="defect-name">{{item.name}}</text>
        <text class="severity sev-{{item.level}}">{{item.levelText}}</text>
      </view>
      <text class="defect-cause">{{item.causeBrief}}</text>
      <view class="defect-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tagItem" wx:key="*this" class="tag">{{tagItem}}</text>
      </view>
    </view>
    <text class="defect-arrow">›</text>
  </view>

  <view wx:if="{{!list.length}}" class="empty card">
    <text class="empty-mark">— —</text>
    <text class="empty-title">没有匹配的缺陷</text>
    <text class="empty-desc">试试「层纹」「气泡」「喷涂」等关键词</text>
  </view>

  <text class="page-tip">修复建议为通用经验，精细件请先在废件上试做</text>
</view>
