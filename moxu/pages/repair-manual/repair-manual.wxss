/* 修复手册样式 */
.repair-page {
  padding-bottom: 70rpx;
}

.lib-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 6rpx 0 24rpx;
}

.lib-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #2C3036;
}

.lib-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A8F96;
}

.lib-count {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.chip-scroll {
  width: 100%;
  height: 68rpx;
  margin-top: 22rpx;
  white-space: nowrap;
}

/* 缺陷卡片 */
.defect-card {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 26rpx 22rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.defect-hover {
  background: #FAF9F7;
}

.defect-no {
  width: 56rpx;
  margin-right: 16rpx;
  padding-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
  color: #E27B48;
}

.defect-body {
  flex: 1;
  min-width: 0;
}

.defect-head {
  display: flex;
  align-items: center;
}

.defect-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3036;
}

.severity {
  margin-left: 14rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
}

.sev-1 {
  background: #EDF1EA;
  color: #6B8A72;
}

.sev-2 {
  background: #F8F0E2;
  color: #B08034;
}

.sev-3 {
  background: #F9E9E4;
  color: #B9503A;
}

.defect-cause {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #8A8F96;
}

.defect-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.defect-tags .tag {
  margin: 0 10rpx 6rpx 0;
}

.defect-arrow {
  margin-left: 10rpx;
  padding-top: 2rpx;
  font-size: 36rpx;
  line-height: 1;
  color: #C7C3BB;
}
