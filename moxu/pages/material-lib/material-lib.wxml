<!-- 材料库：搜索 + 分类筛选 + 展开式材料工艺卡 -->
<view class="page material-page">

  <view class="lib-head">
    <view>
      <text class="lib-title">MATERIALS</text>
      <text class="lib-sub">8 种手工模型常用材料 · 工艺参数速查</text>
    </view>
    <text class="lib-count num">{{materials.length}} / {{total}}</text>
  </view>

  <view class="search-box">
    <view class="search-icon"></view>
    <input
      class="search-input"
      placeholder="搜索材料 / 用途 / 特性"
      placeholder-class="placeholder"
      value="{{keyword}}"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear" catchtap="clearKeyword">清除</text>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="chip-scroll" scroll-x enable-flex>
    <view class="chip-row">
      <view
        wx:for="{{cats}}"
        wx:key="*this"
        class="chip {{activeCat === item ? 'chip-active' : ''}}"
        data-cat="{{item}}"
        bindtap="onCat"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 材料卡片 -->
  <view
    wx:for="{{materials}}"
    wx:key="id"
    class="mat-card {{expandedId === item.id ? 'mat-card-open' : ''}}"
    data-id="{{item.id}}"
    bindtap="toggleCard"
  >
    <view class="mat-head">
      <view class="mat-badge">{{item.short}}</view>
      <view class="mat-title">
        <text class="mat-name">{{item.name}}</text>
        <text class="mat-en">{{item.en}}</text>
      </view>
      <text class="mat-cat">{{item.cat}}</text>
      <text class="mat-toggle">{{expandedId === item.id ? '收起' : '详情'}}</text>
    </view>

    <!-- 速览参数 -->
    <view class="mat-quick">
      <view class="quick-cell">
        <text class="quick-label">收缩率</text>
        <text class="quick-value">{{item.shrink}}</text>
      </view>
      <view class="quick-cell quick-cell-right">
        <text class="quick-label">推荐砂纸</text>
        <text class="quick-value">{{item.sandpaperShort}}</text>
      </view>
    </view>

    <!-- 展开详情 -->
    <view wx:if="{{expandedId === item.id}}" class="mat-detail">
      <view class="detail-row">
        <text class="detail-label">砂纸梯度</text>
        <text class="detail-text">{{item.sandpaper}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">粘接方案</text>
        <text class="detail-text">{{item.bond}}</text>
      </view>
      <view class="safety-box">
        <text class="safety-label">安全注意事项</text>
        <text class="detail-text">{{item.safety}}</text>
      </view>
      <view class="pros-cons">
        <view class="pc-col">
          <text class="pc-title">优点</text>
          <text class="detail-text">{{item.pros}}</text>
        </view>
        <view class="pc-col">
          <text class="pc-title pc-title-con">局限</text>
          <text class="detail-text">{{item.cons}}</text>
        </view>
      </view>
      <view class="mat-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tagItem" wx:key="*this" class="tag">{{tagItem}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!materials.length}}" class="empty card">
    <text class="empty-mark">— —</text>
    <text class="empty-title">没有匹配的材料</text>
    <text class="empty-desc">试试「树脂」「补土」「板材」等关键词</text>
  </view>

  <text class="page-tip">参数为常见经验值，实际以产品说明与安全规范为准</text>
</view>
