/* 首页样式 */
.index-page {
  padding-bottom: 180rpx;
}

/* 品牌区 */
.brand {
  display: flex;
  align-items: center;
  padding: 6rpx 0 28rpx;
}

.brand-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #2C3036;
  border-radius: 6rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
}

.brand-mark::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 14rpx;
  background: #E27B48;
  border: 4rpx solid #F4F2EF;
}

.brand-text {
  flex: 1;
  margin-left: 22rpx;
}

.brand-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.1;
}

.brand-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #8A8F96;
}

.brand-stat {
  text-align: right;
}

.brand-num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.brand-label {
  display: block;
  margin-top: 8rpx;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #A6ABB1;
}

/* 快捷入口 */
.quick-row {
  display: flex;
  margin-top: 24rpx;
}

.quick {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 158rpx;
  padding: 20rpx 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
  overflow: hidden;
}

.quick + .quick {
  margin-left: 16rpx;
}

.quick-primary {
  background: #2C3036;
  border-color: #2C3036;
}

.quick-hover {
  opacity: 0.88;
}

.quick-plus {
  font-size: 32rpx;
  line-height: 1;
  color: #E27B48;
}

.quick-index {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #B6B9BE;
}

.quick-info {
  display: flex;
  flex-direction: column;
}

.quick-name {
  font-size: 25rpx;
  font-weight: 600;
  color: #2C3036;
}

.quick-primary .quick-name {
  color: #FFFFFF;
}

.quick-desc {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #8A8F96;
  white-space: nowrap;
}

.quick-primary .quick-desc {
  color: rgba(255, 255, 255, 0.55);
}

/* 列表头 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-count {
  font-size: 20rpx;
  color: #A6ABB1;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  align-items: flex-start;
}

.wf-col {
  flex: 1;
  min-width: 0;
}

.wf-col + .wf-col {
  margin-left: 20rpx;
}

/* 项目卡片 */
.p-card {
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
  overflow: hidden;
}

.p-card-hover {
  background: #FAF9F7;
}

.p-cover-wrap {
  position: relative;
}

.p-cover {
  display: block;
  width: 100%;
  height: 220rpx;
  background: #EDEAE5;
}

.p-cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 148rpx;
  background-image: linear-gradient(135deg, #353B42 0%, #2C3036 100%);
}

.p-empty-label {
  font-size: 16rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.35);
}

.p-type {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  padding: 3rpx 12rpx;
  background: rgba(28, 31, 35, 0.62);
  border-radius: 4rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.p-flag {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  padding: 3rpx 10rpx;
  background: #E27B48;
  border-radius: 4rpx;
  font-size: 18rpx;
  color: #FFFFFF;
}

.p-body {
  padding: 20rpx;
}

.p-name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.42;
  color: #2C3036;
}

.p-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 19rpx;
  color: #8A8F96;
}

.p-bar {
  height: 6rpx;
  margin-top: 14rpx;
  background: #EFECE7;
  border-radius: 3rpx;
  overflow: hidden;
}

.p-fill {
  height: 100%;
  background: #E27B48;
}

.p-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.p-pct {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  color: #E27B48;
}

.p-time {
  font-size: 18rpx;
  color: #A6ABB1;
}

/* 空状态 */
.index-empty {
  margin-top: 16rpx;
}

.empty-action {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.empty-action .btn {
  width: 260rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 44rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: #E27B48;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 42rpx;
  box-shadow: 0 10rpx 24rpx rgba(44, 48, 54, 0.22);
}

.fab-hover {
  background: #C96637;
}
