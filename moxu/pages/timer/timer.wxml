<!-- 工序计时：本地倒计时，页面内提醒 -->
<view class="timer-page">

  <view class="timer-head">
    <text class="timer-kicker">STEP TIMER</text>
    <text class="timer-name">{{name}}</text>
  </view>

  <view class="dial">
    <text class="dial-time num">{{timeText}}</text>
    <text class="dial-status status-{{status}}">{{statusText}}</text>

    <view class="dial-bar">
      <view class="dial-fill" style="width: {{percent}}%"></view>
    </view>
    <view class="dial-meta">
      <text>已进行 {{elapsedText}}</text>
      <text>建议 {{minutes}} 分钟</text>
    </view>
  </view>

  <!-- 控制区 -->
  <view wx:if="{{status !== 'finished'}}" class="control-row">
    <view class="ctrl ctrl-ghost" hover-class="ctrl-hover" bindtap="reset">重置</view>
    <view class="ctrl ctrl-primary" hover-class="ctrl-primary-hover" bindtap="toggleStart">
      {{status === 'running' ? '暂停' : (status === 'paused' ? '继续' : '开始')}}
    </view>
    <view class="ctrl ctrl-ghost" hover-class="ctrl-hover" bindtap="complete">完成</view>
  </view>

  <!-- 结束状态 -->
  <view wx:if="{{status === 'finished'}}" class="finish-box">
    <text class="finish-title">计时结束</text>
    <text class="finish-desc">可返回项目查看整体进度</text>
    <view class="btn btn-primary finish-btn" bindtap="backProject">返回项目</view>
    <text class="finish-reset" bindtap="reset">重新计时</text>
  </view>

  <view class="timer-note">
    <text class="timer-note-line">· 纯前端倒计时，仅在页面内提醒</text>
    <text class="timer-note-line">· 已开启屏幕常亮，请保持小程序在前台</text>
    <text class="timer-note-line">· 结束后可选择标记该工序完成</text>
  </view>
</view>
