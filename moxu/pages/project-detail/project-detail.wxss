/* 项目详情样式 */
.detail-page {
  padding-bottom: 190rpx;
}

/* 头图 */
.hero {
  position: relative;
  height: 360rpx;
  margin: -28rpx -32rpx 0;
  background-image: linear-gradient(160deg, #353B42 0%, #24282D 100%);
  overflow: hidden;
}

.hero-img {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-image: linear-gradient(180deg, rgba(20, 22, 25, 0.28) 0%, rgba(20, 22, 25, 0.8) 100%);
}

.hero-body {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 62rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 4rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.hero-more-hover {
  background: rgba(255, 255, 255, 0.26);
}

.hero-name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
  color: #FFFFFF;
}

.hero-remark {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.62);
}

/* 进度卡 */
.progress-card {
  position: relative;
  z-index: 3;
  margin-top: -34rpx;
  padding: 28rpx 26rpx 26rpx;
}

.progress-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #4A505A;
}

.progress-pct {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
  color: #E27B48;
}

.progress-bar {
  height: 10rpx;
  margin: 18rpx 0 14rpx;
  background: #EFECE7;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #E27B48;
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: #8A8F96;
}

/* 列表头 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-hint {
  font-size: 20rpx;
  color: #A6ABB1;
}

/* 工序卡片 */
.step-list {
  display: flex;
  flex-direction: column;
}

.step-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 22rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.step-card-hover {
  background: #FAF9F7;
}

.step-done {
  border-color: #E5E0D8;
  background: #FCFBF9;
}

.step-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 4rpx 18rpx 0 0;
  border: 2rpx solid #C7C3BB;
  border-radius: 6rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.step-check-on {
  background: #E27B48;
  border-color: #E27B48;
}

.step-check-mark {
  font-size: 24rpx;
  line-height: 1;
  color: #FFFFFF;
}

.step-body {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.step-head {
  display: flex;
  align-items: center;
}

.step-no {
  width: 42rpx;
  margin-right: 8rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #E27B48;
  flex-shrink: 0;
}

.step-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2C3036;
}

.step-done .step-name {
  color: #6F747C;
}

.step-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 8rpx;
  padding-left: 50rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8A8F96;
}

.step-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 12rpx;
  padding-left: 50rpx;
}

.step-min {
  margin-right: 14rpx;
  padding: 2rpx 10rpx;
  background: #FAEDE5;
  border-radius: 4rpx;
  font-size: 19rpx;
  color: #C96637;
}

.step-extra {
  margin-right: 14rpx;
  font-size: 19rpx;
  color: #A6ABB1;
}

.step-done-time {
  display: block;
  margin-top: 8rpx;
  padding-left: 50rpx;
  font-size: 19rpx;
  color: #A6ABB1;
}

/* 计时按钮 */
.step-timer {
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-top: 6rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border: 2rpx solid #E3DFD9;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.step-timer-hover {
  border-color: #E27B48;
  background: #FAEDE5;
}

.step-timer-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
  border: 2rpx solid #8A8F96;
  border-radius: 50%;
}

.step-timer-icon::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 2rpx;
  height: 6rpx;
  background: #8A8F96;
}

.step-timer-text {
  font-size: 20rpx;
  color: #4A505A;
}

/* 空状态按钮 */
.empty-btns {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}

.empty-btns .btn {
  width: 220rpx;
}

.empty-btns .btn + .btn {
  margin-left: 20rpx;
}
