/* 我的页面样式 */
.mine-page {
  padding-bottom: 70rpx;
}

.mine-hero {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  background-image: linear-gradient(150deg, #353B42 0%, #24282D 100%);
  border-radius: 10rpx;
}

.mine-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  background: #E27B48;
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
}

.mine-info {
  flex: 1;
  margin-left: 22rpx;
}

.mine-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #FFFFFF;
}

.mine-version {
  display: block;
  margin-top: 7rpx;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.42);
}

.mine-tag {
  padding: 4rpx 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 4rpx;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 统计 */
.stat-card {
  display: flex;
  margin-top: 20rpx;
  padding: 28rpx 0;
}

.stat-cell {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid #F1EEEA;
}

.stat-cell:last-child {
  border-right: none;
}

.stat-num {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #2C3036;
}

.stat-cell:nth-child(4) .stat-num {
  color: #E27B48;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8F96;
}

.storage-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
  font-size: 19rpx;
  color: #A6ABB1;
}

/* 信息列表 */
.info-card {
  padding: 6rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F3F0EB;
}

.info-row:last-child {
  border-bottom: none;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 15rpx 14rpx 0 0;
  background: #E27B48;
  border-radius: 2rpx;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.7;
  color: #4A505A;
}

/* 内置资料 */
.builtin-card {
  display: flex;
  padding: 28rpx 0;
}

.builtin-cell {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid #F1EEEA;
}

.builtin-cell:last-child {
  border-right: none;
}

.builtin-num {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #E27B48;
}

.builtin-label {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8A8F96;
}

/* 关于 */
.about-card {
  padding: 28rpx 26rpx;
}

.about-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #2C3036;
}

.about-text {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.72;
  color: #4A505A;
}

.about-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1EEEA;
  font-size: 19rpx;
  color: #A6ABB1;
}

/* 清空数据 */
.danger-card {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 24rpx;
  background: #FFF9F7;
  border: 2rpx solid #E5C4BA;
  border-radius: 10rpx;
}

.danger-main {
  flex: 1;
  min-width: 0;
}

.danger-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #B9503A;
}

.danger-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 20rpx;
  color: #A6ABB1;
}

.danger-btn {
  width: 140rpx;
  flex-shrink: 0;
}
