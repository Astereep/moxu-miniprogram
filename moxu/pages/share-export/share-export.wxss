/* 分享导出样式 */
.share-page {
  padding-bottom: 70rpx;
}

/* 项目切换 */
.picker-card {
  display: flex;
  align-items: center;
  padding: 26rpx;
}

.picker-main {
  flex: 1;
  min-width: 0;
}

.picker-label {
  display: block;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #A6ABB1;
}

.picker-name {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 31rpx;
  font-weight: 600;
  color: #2C3036;
}

.picker-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.picker-sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #8A8F96;
}

.picker-switch {
  padding: 14rpx 26rpx;
  border: 2rpx solid #D2CDC4;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #4A505A;
}

.picker-switch-hover {
  background: #EFECE7;
}

/* 清单预览 */
.preview-card {
  padding: 6rpx 24rpx;
}

.pv-row {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 2rpx solid #F3F0EB;
}

.pv-row:last-child {
  border-bottom: none;
}

.pv-no {
  width: 48rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #E27B48;
}

.pv-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 25rpx;
  color: #2C3036;
}

.pv-name-done {
  color: #8A8F96;
}

.pv-min {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #A6ABB1;
}

.pv-check {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #E27B48;
}

.pv-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #8A8F96;
}

/* 操作列表 */
.action-list {
  display: flex;
  flex-direction: column;
}

.action-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: auto;
  padding: 24rpx 22rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
  text-align: left;
  line-height: normal;
  font-size: 28rpx;
  color: #2C3036;
}

.action-row::after {
  border: none;
}

.action-row + .action-row {
  margin-top: 14rpx;
}

.action-hover {
  background: #FAF9F7;
}

.action-index {
  width: 54rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #E27B48;
  flex-shrink: 0;
}

.action-body {
  flex: 1;
  min-width: 0;
}

.action-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #2C3036;
}

.action-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #8A8F96;
}

.action-go {
  margin-left: 12rpx;
  padding: 8rpx 18rpx;
  border: 2rpx solid #E9C3AF;
  border-radius: 4rpx;
  font-size: 21rpx;
  color: #C96637;
  flex-shrink: 0;
}

/* 长图结果 */
.result-box {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3DFD9;
  border-radius: 10rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-head .section-title {
  margin: 0;
  font-size: 26rpx;
}

.result-close {
  font-size: 21rpx;
  color: #8A8F96;
  padding: 8rpx 0 8rpx 20rpx;
}

.result-img {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  border: 2rpx solid #EFECE7;
  border-radius: 6rpx;
  background: #F4F2EF;
}

.result-actions {
  display: flex;
  margin-top: 18rpx;
}

.result-btn {
  flex: 1;
  height: 80rpx;
  font-size: 27rpx;
}

.result-btn + .result-btn {
  margin-left: 14rpx;
}

.result-tip {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A6ABB1;
}

/* 说明 */
.share-note {
  margin-top: 34rpx;
}

.share-note-line {
  display: block;
  font-size: 20rpx;
  line-height: 1.9;
  color: #A6ABB1;
}

/* 离屏画布（透明覆盖在页面上，保证 canvas 正常渲染） */
.export-canvas {
  position: fixed;
  left: 0;
  top: 0;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}

.empty-btns {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}
